@@ -0,0 +1,119 @@
+import { Camera, CameraType } from 'expo-camera';
+import * as FaceDetector from 'expo-face-detector';
+import * as Speech from 'expo-speech';
+import { useEffect, useRef, useState } from 'react';
+import { StyleSheet, Text, View } from 'react-native';
+import { ThemedText } from '@/components/ThemedText';
+import { ThemedView } from '@/components/ThemedView';
+
+export default function FaceScreen() {
+  const [permission, requestPermission] = Camera.useCameraPermissions();
+  const [faces, setFaces] = useState<FaceDetector.FaceFeature[]>([]);
+  const cameraRef = useRef<Camera>(null);
+  const spokenFaces = useRef<Set<number>>(new Set());
+
+  useEffect(() => {
+    if (!permission) {
+      requestPermission();
+    }
+  }, [permission, requestPermission]);
+
+  useEffect(() => {
+    faces.forEach((face) => {
+      if (face.faceID != null && !spokenFaces.current.has(face.faceID)) {
+        Speech.speak(describeFace(face));
+        spokenFaces.current.add(face.faceID);
+      }
+    });
+  }, [faces]);
+
+  function describeFace(face: FaceDetector.FaceFeature) {
+    const info: string[] = [];
+    if (typeof face.smilingProbability === 'number') {
+      info.push(
+        `smile ${(face.smilingProbability * 100).toFixed(0)} percent`
+      );
+    }
+    if (typeof face.leftEyeOpenProbability === 'number') {
+      info.push(
+        `left eye open ${(face.leftEyeOpenProbability * 100).toFixed(0)} percent`
+      );
+    }
+    if (typeof face.rightEyeOpenProbability === 'number') {
+      info.push(
+        `right eye open ${(face.rightEyeOpenProbability * 100).toFixed(0)} percent`
+      );
+    }
+    return info.length ? `Face detected. ${info.join('. ')}` : 'Face detected';
+  }
+
+  if (!permission || !permission.granted) {
+    return (
+      <ThemedView style={styles.center}>
+        <ThemedText>Camera permission is required.</ThemedText>
+      </ThemedView>
+    );
+  }
+
+  return (
+    <View style={styles.container}>
+      <Camera
+        ref={cameraRef}
+        style={StyleSheet.absoluteFill}
+        type={CameraType.front}
+        onFacesDetected={(event) =>
+          setFaces((event as FaceDetector.DetectionResult).faces)
+        }
+        faceDetectorSettings={{
+          mode: FaceDetector.FaceDetectorMode.fast,
+        }}
+      />
+      {faces.map((face) => (
+        <View
+          key={face.faceID}
+          style={[
+            styles.box,
+            {
+              left: face.bounds.origin.x,
+              top: face.bounds.origin.y,
+              width: face.bounds.size.width,
+              height: face.bounds.size.height,
+            },
+          ]}
+        >
+          <Text style={styles.label}>
+            {face.smilingProbability !== undefined
+              ? `Smile ${(face.smilingProbability * 100).toFixed(0)}%\n`
+              : ''}
+            {face.leftEyeOpenProbability !== undefined &&
+              `L eye ${(face.leftEyeOpenProbability * 100).toFixed(0)}%`}
+            {face.rightEyeOpenProbability !== undefined &&
+              ` R eye ${(face.rightEyeOpenProbability * 100).toFixed(0)}%`}
+          </Text>
+        </View>
+      ))}
+    </View>
+  );
+}
+
+const styles = StyleSheet.create({
+  container: {
+    flex: 1,
+  },
+  center: {
+    flex: 1,
+    alignItems: 'center',
+    justifyContent: 'center',
+  },
+  box: {
+    position: 'absolute',
+    borderWidth: 2,
+    borderColor: 'red',
+  },
+  label: {
+    color: 'white',
+    backgroundColor: 'rgba(0,0,0,0.6)',
+    fontSize: 12,
+    paddingHorizontal: 2,
+  },
+});
